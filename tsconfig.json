{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
